# ─────────────────────────────────────────────────────────────────────────────
# DocSummary AI — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file and rename it to .env
# 2. Fill in your actual values below
# 3. Run the backend using:  start.bat  (Windows)
#                            ./start.sh  (macOS/Linux)
#
# ⚠️  NEVER commit .env to Git — it is listed in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter API Key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model to use
OPENROUTER_MODEL=z-ai/glm-5.2:free

# Tesseract data path (only needed for OCR on image files)
# Windows default: C:\Program Files\Tesseract-OCR\tessdata
# macOS (brew):    /opt/homebrew/share/tessdata
# Linux:           /usr/share/tesseract-ocr/4.00/tessdata
TESSDATA_PREFIX=tessdata

# Server port (optional — default is 8080)
SERVER_PORT=8080
